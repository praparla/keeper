generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Better Auth models. Keep these aligned with `npx auth@latest generate`.
model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String?   @unique
  emailVerified        DateTime?
  authEmailVerified    Boolean   @default(false)
  image                String?
  color                String?   @default("teal")
  timezone             String    @default("America/New_York")
  digestEmail          Boolean   @default(true)
  immediateEmail       Boolean   @default(true)
  weeklyEmail          Boolean   @default(true)
  legacyPhoneNumber    String?   @map("phoneNumber")
  legacyEmailReminders Boolean   @default(true) @map("emailReminders")
  legacySmsReminders   Boolean   @default(true) @map("smsReminders")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts       AuthAccount[]
  sessions       AuthSession[]
  legacyAccounts LegacyAccount[]
  legacySessions LegacySession[]
  memberships    Membership[]
  invites        Invite[]        @relation("InviteCreator")
  assignedTasks  Task[]          @relation("Assignee")
  createdTasks   Task[]          @relation("Creator")
  medications    Medication[]    @relation("MedDefaultAssignee")
  appointments   Appointment[]   @relation("ApptAttendee")
}

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Preserved through the auth cutover. Remove only after production Better Auth succeeds.
model LegacyAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("Account")
}

model LegacySession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model LegacyVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

model CareCircle {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Membership[]
  invites     Invite[]
  tasks       Task[]
  recipients  CareRecipient[]
  suggestions Suggestion[]
}

// ── Care recipients & profile ──
enum ResidenceType {
  HOUSE
  CONDO
  APARTMENT
  FACILITY
}

model CareRecipient {
  id            String         @id @default(cuid())
  circleId      String
  name          String
  relationship  String?
  birthYear     Int?
  zip           String?
  climateRegion String?
  timezone      String         @default("America/New_York")
  residenceType ResidenceType?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  circle       CareCircle              @relation(fields: [circleId], references: [id], onDelete: Cascade)
  facts        ProfileFact[]
  providers    Provider[]
  conditions   Condition[]
  medications  Medication[]
  appointments Appointment[]
  vitalInfo    VitalInfo[]
  tasks        Task[]
  suggestions  Suggestion[]
  suppressions SuggestionSuppression[]

  @@index([circleId])
}

enum FactSource {
  ONBOARDING
  MANUAL
  DISMISSAL
  DEFAULT
}

model ProfileFact {
  id          String        @id @default(cuid())
  recipientId String
  key         String
  value       String
  source      FactSource    @default(ONBOARDING)
  updatedAt   DateTime      @updatedAt
  recipient   CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, key])
}

// ── Medical ──
model Provider {
  id          String        @id @default(cuid())
  recipientId String
  name        String
  specialty   String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  recipient   CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  medications  Medication[]
  appointments Appointment[]

  @@index([recipientId])
}

model Condition {
  id          String        @id @default(cuid())
  recipientId String
  name        String
  notes       String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  recipient   CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model Medication {
  id                 String    @id @default(cuid())
  recipientId        String
  name               String
  dose               String?
  schedule           String?
  pharmacy           String?
  prescriberId       String?
  refillIntervalDays Int?
  lastFilledAt       DateTime?
  defaultAssigneeId  String?
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  recipient       CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  prescriber      Provider?     @relation(fields: [prescriberId], references: [id], onDelete: SetNull)
  defaultAssignee User?         @relation("MedDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  refillTasks     Task[]

  @@index([recipientId])
  @@index([prescriberId])
}

enum ApptStatus {
  SCHEDULED
  DONE
  CANCELLED
}

model Appointment {
  id          String     @id @default(cuid())
  recipientId String
  providerId  String?
  title       String
  startsAt    DateTime
  location    String?
  attendeeId  String?
  notes       String?
  outcome     String?
  status      ApptStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  recipient CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  provider  Provider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  attendee  User?         @relation("ApptAttendee", fields: [attendeeId], references: [id], onDelete: SetNull)

  @@index([recipientId, startsAt])
  @@index([providerId])
}

enum CircleRole {
  OWNER
  MEMBER
  VIEWER
}

model Membership {
  id       String     @id @default(cuid())
  userId   String     @unique
  circleId String
  role     CircleRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
  @@index([circleId])
}

model Invite {
  id          String     @id @default(cuid())
  circleId    String
  token       String     @unique
  role        CircleRole @default(MEMBER)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  circle      CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  invitedBy   User       @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([circleId])
  @@index([invitedById])
}

enum TaskType {
  Medical
  Household
  Errand
  Note
}

enum TaskStatus {
  Open
  InProgress
  Resolved
}

enum Recurrence {
  NONE
  DAYS
  WEEKLY
  MONTHLY
  YEARLY
  SEASONAL
}

model Task {
  id          String     @id @default(cuid())
  circleId    String
  recipientId String?
  title       String
  description String?
  type        TaskType   @default(Note)
  status      TaskStatus @default(Open)
  priority    Boolean    @default(false)
  dueDate     DateTime?

  // recurrence (materialized-next-instance)
  recurrence       Recurrence @default(NONE)
  recurEveryDays   Int?
  windowStartMonth Int?
  windowStartDay   Int?
  windowEndMonth   Int?
  windowEndDay     Int?

  // provenance
  suggestionId String? @unique
  medicationId String?
  templateSlug String?

  circle     CareCircle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  recipient  CareRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  medication Medication?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  suggestion Suggestion?    @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?          @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?          @relation("Creator", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId, status, dueDate])
  @@index([recipientId])
  @@index([medicationId])
  @@index([assigneeId])
  @@index([creatorId])
}

model VitalInfo {
  id          String        @id @default(cuid())
  recipientId String
  category    String
  content     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  recipient   CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, category])
  @@index([recipientId])
}

// ── Suggestion engine ──
enum TemplateCategory {
  HOME_SEASONAL
  HOME_SAFETY
  MEDICAL_ADMIN
  VEHICLE
  FINANCIAL_ADMIN
}

enum TriggerType {
  SEASONAL_WINDOW
  FIXED_DATE
  INTERVAL
  ONE_TIME_AGE
  WEATHER // reserved for P2; never seeded active
}

enum IntervalAnchor {
  ASSUME_DUE
  START_FRESH
}

model SuggestionTemplate {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  reasonTemplate    String
  category          TemplateCategory
  triggerType       TriggerType
  windowStartMonth  Int?
  windowStartDay    Int?
  windowEndMonth    Int?
  windowEndDay      Int?
  intervalDays      Int?
  intervalAnchor    IntervalAnchor?
  leadDays          Int              @default(14)
  minAge            Int?
  requiresFacts     Json? // structured gates: { facts, residence, regions, minActiveMeds } (see src/lib/engine)
  climateSensitive  Boolean          @default(false)
  defaultTaskType   TaskType         @default(Household)
  defaultRecurrence Recurrence       @default(NONE)
  sourceUrl         String?
  active            Boolean          @default(true)
  catalogVersion    Int              @default(1)

  suggestions Suggestion[]
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  SNOOZED
  DISMISSED
  EXPIRED
}

enum DismissReason {
  NOT_APPLICABLE
  SELF_HANDLED
  NOT_NOW
}

model Suggestion {
  id            String           @id @default(cuid())
  circleId      String
  recipientId   String?
  templateId    String?
  cycleKey      String
  title         String
  reason        String
  windowStart   DateTime
  windowEnd     DateTime?
  status        SuggestionStatus @default(PENDING)
  snoozedUntil  DateTime?
  dismissReason DismissReason?
  createdAt     DateTime         @default(now())

  circle       CareCircle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  recipient    CareRecipient?      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  template     SuggestionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  acceptedTask Task?

  // cycleKey embeds its scope ("recip_abc:2026-fall" / "circle:2026-tax-filing") so the
  // (templateId, cycleKey) unique constraint dedupes both recipient- and circle-level rows
  // despite recipientId being nullable (Postgres treats NULLs as distinct — §10).
  @@unique([templateId, cycleKey])
  @@index([circleId, status])
}

model SuggestionSuppression {
  id           String        @id @default(cuid())
  recipientId  String
  templateSlug String
  reason       DismissReason
  createdAt    DateTime      @default(now())
  recipient    CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, templateSlug])
}

// ── Observability ──
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  counts     Json?
  error      String?

  @@index([job, startedAt])
}
